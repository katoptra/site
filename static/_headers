/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://healthchecks.io https://api.github.com; frame-ancestors 'none'; form-action 'self'

# This rule is for the files in /fonts/: Gabarito and its OFL from static/fonts/, and the
# fonts of the theme. Hugo does not fingerprint these files, and their names have no
# content hash. But the rule sets them as immutable for one year. Give a changed font a new
# file name. With the same name, a cache can keep the previous font for a maximum of one
# year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Hugo fingerprints the CSS and JS files, and their names have a content hash. A changed
# file gets a new name. Thus, it is safe to set these files as immutable for one year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800

# The mark and the tokens. The katoptra READMEs refer to them with their URLs.
/brand/*
  Cache-Control: public, max-age=604800
